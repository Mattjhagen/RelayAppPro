[Unit]
Description=Cloudflare Tunnel for OpenCode Mobile
After=network.target

[Service]
Type=simple
User=matt
WorkingDirectory=/home/matt/opencode-mobile
ExecStart=/usr/local/bin/cloudflared tunnel --config .cloudflared-opencode.yml run
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloudflared-opencode

[Install]
WantedBy=multi-user.target
